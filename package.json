{
  "name": "vtube-maker",
  "version": "1.0.0",
  "description": "Memory-efficient Electron + Vue video editor",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview -- --no-sandbox",
